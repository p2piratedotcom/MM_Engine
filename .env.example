# Il trading e i trasferimenti reali restano spenti finche non vengono
# abilitati esplicitamente nell'interfaccia locale.
KDF_MM_LIVE_TRADING=false
KDF_MM_LIVE_TRANSFERS=false
KDF_MM_KDF_ORDER_WRITES=false

# KDF resta in ascolto solo su localhost della VPS.
KDF_RPC_URL=http://127.0.0.1:7783
KDF_RPC_USERPASS=replace-me-on-vps
KDF_BINARY_MANIFEST=vendor/kdf/official-v2.6.0-beta-475cdb49/manifest.json
KDF_CONFIG_PATH=runtime/MM2.json
KDF_COINS_PATH=vendor/coins/1d43cdefb0594583191d5ef5311f1b4b37a62a53/coins
# Lasciare il manifest valorizzato usa il registry minimo verificato. Per un
# registry KDF completo scelto localmente, impostarlo a stringa vuota.
KDF_COINS_MANIFEST=vendor/coins/manifest.json

# API locale del VPS Agent. Generare due segreti distinti e lunghi.
KDF_MM_AGENT_BIND=127.0.0.1
KDF_MM_AGENT_PORT=8765
KDF_MM_AGENT_TOKEN=
KDF_MM_SNAPSHOT_SECRET=
KDF_MM_MARKET_DATA_MAX_AGE_MS=10000
KDF_MM_STATE_DB=var/vps-agent.sqlite3
KDF_MM_MEXC_PUBLIC_FEED=false
KDF_MM_MEXC_FEED_INTERVAL_SECONDS=3
KDF_MM_MEXC_DEPTH_LIMIT=100
KDF_MM_MANAGE_KDF=false
KDF_MM_KDF_SUPERVISOR_STATE=var/kdf-supervisor.json
KDF_MM_KDF_LOG_PATH=var/kdf.log
KDF_MM_KDF_START_TIMEOUT_SECONDS=30
KDF_MM_REPRICING_POLL_INTERVAL_SECONDS=3
KDF_MM_REPRICING_MIN_PRICE_CHANGE=0.0025
KDF_MM_REPRICING_MIN_UPDATE_INTERVAL_SECONDS=15
KDF_MM_RECONCILIATION_INTERVAL_SECONDS=2
KDF_MM_RECONCILIATION_RECENT_SWAP_LIMIT=100
KDF_MM_KDF_EVENT_STREAM=false
KDF_MM_KDF_EVENT_STREAM_CLIENT_ID=4107

# Queste chiavi devono esistere solo sul PC Zorin, mai sulla VPS.
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://api.mexc.com

# Valori iniziali prudenti; sono modificabili dalla GUI.
KDF_MM_PAIR=ARRRUSDT
# Mercati KDF gestiti. LTC e solo un esempio: ARRR-DOGE, ARRR-KMD, ecc. sono
# costruiti senza modifiche al codice se esiste la relativa rotta MEXC/USDT.
KDF_MM_MARKETS=ARRR-USDT-BEP20,ARRR-LTC
# Solo per ticker KDF con nome diverso da MEXC (JSON su una singola riga).
# KDF_MM_MEXC_QUOTE_SYMBOLS={"BTC-BEP20":"BTCUSDT"}
# USDT su BNB Smart Chain; BNB serve per il gas.
KDF_MM_KDF_QUOTE_TICKER=USDT-BEP20
KDF_MM_PREMIUM=0.02
KDF_MM_CEX_TAKER_FEE=0.001
KDF_MM_RISK_BUFFER=0.005
KDF_MM_MAX_SLIPPAGE=0.01
KDF_MM_MAX_DAILY_VOLUME_FRACTION=0.005

# Prima politica di portafoglio, solo per calcoli e suggerimenti non eseguibili.
KDF_MM_PORTFOLIO_KDF_ARRR_TARGET_FRACTION=0.5
KDF_MM_PORTFOLIO_KDF_USDT_TARGET_FRACTION=0.5
KDF_MM_PORTFOLIO_REBALANCE_MINIMUM_USDT=5
